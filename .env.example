# Ndank — variables d'environnement du niveau 2.
#
# Copier en `.env` et remplir. `.env` est ignoré par Git, et il doit le rester :
# les clés ci-dessous donnent le droit de débiter des abonnés.

# ── la base ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://ndank:ndank@localhost:5432/ndank"

# ── les fournisseurs ──────────────────────────────────────────────────────
#
# Aucune de ces clés n'est stockée en base, et c'est délibéré : une base est
# sauvegardée, répliquée, restaurée sur un poste de développement. Une clé
# secrète qui suit ce chemin est une clé compromise, sans que personne ne s'en
# aperçoive.
#
# Ne remplir que les fournisseurs réellement utilisés. `champsManquants()`
# refuse de démarrer sur une configuration incomplète plutôt que de laisser le
# fournisseur répondre « 401 » un matin, au premier abonné à relancer.

# Flutterwave — agrégateur. Couvre XOF, XAF, GHS, NGN, UGX, RWF.
FLUTTERWAVE_CLE_SECRETE=""
FLUTTERWAVE_SECRET_WEBHOOK=""
# Laisser vide ou "false" tant qu'on n'est pas prêt : on ne part pas en
# production par accident.
FLUTTERWAVE_PRODUCTION="false"

# Paystack — agrégateur. La même clé sert à vérifier la signature des webhooks.
PAYSTACK_CLE_SECRETE=""

# MTN MoMo — opérateur en direct. L'utilisateur d'API et sa clé se créent une
# fois, hors ligne ; la clé d'abonnement vient du produit Collections.
MTN_UTILISATEUR_API=""
MTN_CLE_API=""
MTN_CLE_ABONNEMENT=""
# "sandbox", puis le nom du marché en production : mtnivorycoast, mtnghana…
MTN_ENVIRONNEMENT="sandbox"

# ── pas encore branchés ───────────────────────────────────────────────────
#
# Ces adaptateurs lèvent tant qu'ils ne sont pas écrits, mais leurs champs sont
# déjà fixés : un compte marchand met des semaines à ouvrir, et il vaut mieux
# lancer les démarches maintenant.

# ORANGE_CLE_MARCHAND=""
# ORANGE_IDENTIFIANT_CLIENT=""
# ORANGE_SECRET_CLIENT=""
# ORANGE_CODE_MARCHAND=""

# WAVE_CLE_API=""
# WAVE_SECRET_WEBHOOK=""

# MOOV_IDENTIFIANT_MARCHAND=""
# MOOV_MOT_DE_PASSE=""
# MOOV_CODE_MARCHAND=""

# DJAMO_CLE_API=""
# DJAMO_SECRET_WEBHOOK=""

# ── les passerelles d'envoi ───────────────────────────────────────────────
#
# Ne remplir que les canaux réellement branchés. Un canal sans passerelle
# n'est pas « disponible » : le moteur descendra au canal suivant du palier,
# et rien ne cassera.
#
# `verifierEnvoi()` refuse de laisser démarrer une application dont l'envoi
# n'est pas configuré, et cette vérification-là compte plus que celle des
# paiements. Une clé de paiement absente se découvre au premier abonné qui
# clique. Une clé d'envoi absente ne se découvre pas : le passage tourne,
# l'erreur est rattrapée, le bilan compte un « injoignable » de plus — et ce
# chiffre n'alerte personne. La panne se voit au troisième jour, quand
# l'accès tombe pour un abonné qui n'a rien reçu.

# Courriel — Resend. Le domaine de l'expéditeur doit être vérifié chez eux :
# c'est le premier obstacle réel, et il n'a rien à voir avec la clé.
RESEND_CLE_API=""
RESEND_EXPEDITEUR="Baobart <no-reply@baobart.ci>"

# Courriel — Brevo (l'ancien Sendinblue), si vous y avez déjà un compte.
# La clé va dans un en-tête « api-key », pas dans un Bearer.
# BREVO_CLE_API=""
# BREVO_EXPEDITEUR="no-reply@baobart.ci"
# BREVO_NOM_EXPEDITEUR="Baobart"

# SMS — Twilio. C'est le seul canal du dernier palier : si rien n'est branché
# ici, personne n'est prévenu au moment où l'accès va tomber.
TWILIO_SID=""
TWILIO_JETON=""
# L'un OU l'autre, jamais les deux.
TWILIO_EXPEDITEUR=""
# TWILIO_SERVICE_MESSAGERIE=""
# L'indicatif à préfixer aux numéros stockés en local. Le zéro de tête N'EST
# PAS retiré : en Côte d'Ivoire il fait partie du numéro depuis 2021.
TWILIO_INDICATIF_PAR_DEFAUT="225"
# À "true" seulement pour un plan de numérotation où le zéro est un préfixe
# national — la France, par exemple. Pas la zone franc.
TWILIO_RETIRER_ZERO_DE_TETE="false"

# Notification — Expo. Aucun champ n'est requis : le jeton d'accès ne sert
# qu'aux projets qui exigent l'authentification des envois.
# EXPO_JETON_ACCES=""

# ── passerelles pas encore branchées ──────────────────────────────────────
#
# Mêmes raisons que pour les opérateurs de paiement : un identifiant
# d'expéditeur alphanumérique se négocie avec chaque opérateur, et cela prend
# des semaines. Les champs sont fixés pour qu'on puisse lancer les démarches.

# Orange SMS — nettement moins cher qu'un SMS international vers un abonné
# Orange, et l'expéditeur alphanumérique est inclus au contrat.
# ORANGE_SMS_IDENTIFIANT_CLIENT=""
# ORANGE_SMS_SECRET_CLIENT=""
# ORANGE_SMS_EXPEDITEUR=""

# Africa's Talking — agrégateur panafricain, l'alternative à Twilio quand le
# volume justifie de sortir du tarif international.
# AFRICASTALKING_UTILISATEUR=""
# AFRICASTALKING_CLE_API=""
# AFRICASTALKING_EXPEDITEUR=""

# Firebase Cloud Messaging — pour une application Android native. Ceux qui
# passent par Expo n'en ont pas besoin.
# FCM_PROJET_ID=""
# FCM_COURRIEL_COMPTE_SERVICE=""
# FCM_CLE_PRIVEE_COMPTE_SERVICE=""

# Web Push — le seul canal où Ndank aurait à manipuler des clés de
# chiffrement, ce que `Coordonnees` dit vouloir éviter.
# WEBPUSH_CLE_VAPID_PUBLIQUE=""
# WEBPUSH_CLE_VAPID_PRIVEE=""
# WEBPUSH_SUJET_VAPID="mailto:contact@baobart.ci"

# ── la page de validation et l'API ────────────────────────────────────────
#
# NDANK_SECRET signe les liens de relance. Deux exigences, et les deux
# comptent :
#
#   — il doit être long et tiré au hasard. Un secret devinable rend le lien
#     forgeable, donc la page d'un abonné lisible par n'importe qui ;
#   — il ne doit PAS changer. Le changer invalide d'un coup tous les liens
#     déjà partis, y compris ceux du dernier palier — c'est-à-dire ceux des
#     abonnés qu'on allait couper.
#
#   openssl rand -base64 32
NDANK_SECRET=""

# L'adresse publique de la page, telle que l'abonné la voit. Elle sert à
# fabriquer les liens de retour du fournisseur : ce doit être celle du nom de
# domaine, pas celle du conteneur.
NDANK_BASE="https://p.baobart.ci/v"

# Le jeton que le tableau de bord présente à l'API. Distinct de NDANK_SECRET :
# il vit dans une application distribuée, donc il est extractible, et une
# fuite ne doit pas emporter la signature des liens.
#
#   openssl rand -base64 32
NDANK_JETON_TABLEAU=""

# Le jeton des gestes du tableau de bord — DISTINCT de NDANK_JETON_TABLEAU.
#
# Celui-ci autorise à écrire : suspendre, résilier, marquer payé, relancer.
# Il vit sur votre serveur, jamais dans une application distribuée.
#
# Les partager reviendrait à donner le droit d'écrire à un client dont le
# jeton est extractible — un jeton volé dans une application Android
# permettrait alors de marquer des abonnements comme payés.
#
#   openssl rand -base64 32
NDANK_JETON_GESTES=""
